---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Hakkimda from '../components/Hakkimda.astro';
import Hizmetler from '../components/Hizmetler.astro';
import UygulananTestler from '../components/UygulananTestler.astro';
import GorusmeBicimi from '../components/GorusmeBicimi.astro';
import Iletisim from '../components/Iletisim.astro';
import Harita from '../components/Harita.astro';
import {
  business,
  postalAddress,
  openingHoursSpecification,
  mapsDirectionsUrl,
} from '../data/business';

const services = [
  'Bireysel Terapi',
  'Online Terapi',
  'Çocuk ve Ergen Danışmanlığı',
  'Oyun Terapisi',
  'MOXO Dikkat Testi',
  'Aile ve Çift Danışmanlığı',
  'Montessori Eğitimi',
  'P4C Çocuklar İçin Felsefe',
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Psychologist', 'LocalBusiness', 'ProfessionalService'],
      '@id': 'https://selinunal.com/#praxis',
      name: business.name,
      alternateName: 'Karabük Psikolog Selin Ünal',
      description:
        'Safranbolu ve Karabük’te bireysel terapi, aile ve çift danışmanlığı, oyun terapisi ile çocuk-ergen danışmanlığı sunan psikolog. Türkiye genelinde online görüşme.',
      url: 'https://selinunal.com/',
      image: 'https://selinunal.com/assets/selin-unal-about.webp',
      email: business.email,
      telephone: business.phone.intl,
      sameAs: [business.instagram],
      currenciesAccepted: 'TRY',
      address: postalAddress,
      hasMap: mapsDirectionsUrl,
      areaServed: [
        ...business.serviceAreas.map((name) => ({ '@type': 'City', name })),
        { '@type': 'Country', name: 'Türkiye' },
      ],
      availableLanguage: { '@type': 'Language', name: 'Türkçe' },
      openingHoursSpecification,
      founder: { '@id': 'https://selinunal.com/#selin' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Psikolojik danışmanlık hizmetleri',
        itemListElement: services.map((name) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name,
            provider: { '@id': 'https://selinunal.com/#praxis' },
            areaServed: [...business.serviceAreas],
          },
        })),
      },
    },
    {
      '@type': 'Person',
      '@id': 'https://selinunal.com/#selin',
      name: 'Selin Ünal',
      jobTitle: 'Psikolog, Aile Danışmanı',
      telephone: business.phone.intl,
      email: business.email,
      sameAs: [business.instagram],
      worksFor: { '@id': 'https://selinunal.com/#praxis' },
      knowsAbout: [
        'Bilişsel Davranışçı Terapi',
        'Aile Danışmanlığı',
        'Çocuk ve Ergen Psikolojisi',
        'Oyun Terapisi',
      ],
      workLocation: {
        '@type': 'Place',
        name: `${business.address.district} / ${business.address.province}`,
        address: postalAddress,
      },
      url: 'https://selinunal.com/ben-kimim',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://selinunal.com/#website',
      url: 'https://selinunal.com/',
      name: business.name,
      inLanguage: 'tr-TR',
      publisher: { '@id': 'https://selinunal.com/#praxis' },
    },
    {
      '@type': 'WebPage',
      '@id': 'https://selinunal.com/#webpage',
      url: 'https://selinunal.com/',
      name: 'Karabük Psikolog Selin Ünal | Yüz Yüze ve Online',
      isPartOf: { '@id': 'https://selinunal.com/#website' },
      about: { '@id': 'https://selinunal.com/#praxis' },
      inLanguage: 'tr-TR',
    },
  ],
};
---
<Base
  title="Karabük Psikolog Selin Ünal | Yüz Yüze ve Online"
  description="Karabük ve Safranbolu psikolog Selin Ünal ile bireysel, çocuk-ergen ve aile danışmanlığı. Yüz yüze ve online görüşme için randevu alın."
  canonical="/"
  ogDescription="Safranbolu ve Karabük’te yüz yüze, Türkiye genelinde online psikolojik danışmanlık. Bireysel, çocuk-ergen, oyun terapisi ile aile ve çift danışmanlığı."
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  active="anasayfa"
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(schema)} />
  <Hero />
  <Hakkimda />
  <Hizmetler />
  <UygulananTestler />
  <GorusmeBicimi />
  <Iletisim />
  <Harita />
</Base>
