---
---

<section id="iletisim" class="contact-section">
  <div class="contact-grid">
    <div class="contact-copy reveal">
      <p class="eyebrow"><span></span> İletişim</p>
      <h2>Benimle<br><em>iletişime</em><br>geçin.</h2>
      <p class="contact-lead">İlk adımı atmak için formu doldurun. Uygun bir görüşme zamanı belirlemek üzere size dönüş yapalım.</p>

      <div class="contact-details" aria-label="İletişim bilgileri">
        <div class="contact-detail">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <div><strong>E-posta</strong><a href="mailto:psk.selinunal@gmail.com">psk.selinunal@gmail.com</a></div>
        </div>
        <div class="contact-detail">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          <div><strong>Instagram</strong><a href="https://www.instagram.com/psk.selinunal/" target="_blank" rel="noopener">@psk.selinunal</a></div>
        </div>
        <div class="contact-detail">
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>
          <div><strong>Görüşme</strong><span>Karabük’te yüz yüze, Türkiye genelinde online</span></div>
        </div>
      </div>
    </div>

    <div class="form-card reveal reveal-delay">
      <form class="contact-form" data-contact-form>
        <label>
          <span>Ad Soyad *</span>
          <input name="name" type="text" autocomplete="name" placeholder="Adınız Soyadınız" required>
        </label>
        <label>
          <span>E-posta *</span>
          <input name="email" type="email" autocomplete="email" placeholder="eposta@ornek.com" required>
        </label>
        <label class="form-wide">
          <span>Görüşme Tercihi</span>
          <select name="preference">
            <option value="">Seçin…</option>
            <option>Online</option>
            <option>Yüz yüze</option>
          </select>
        </label>
        <label class="form-wide">
          <span>Başvuru Konusu</span>
          <input name="topic" type="text" data-subject-field placeholder="Örn: kaygı, ilişki sorunları…">
        </label>
        <label class="form-wide">
          <span>Mesajınız *</span>
          <textarea name="message" rows="5" placeholder="Kendinizden ve beklentilerinizden kısaca bahsedebilirsiniz…" required></textarea>
        </label>
        <label class="form-consent form-wide">
          <input name="consent" type="checkbox" value="evet" required>
          <span><a href="/kvkk" target="_blank" rel="noopener">Aydınlatma Metni</a>’ni okudum; e-posta adresimin randevu talebimin değerlendirilmesi amacıyla işlenmesine açık rıza veriyorum. *</span>
        </label>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="sr-only">
        <button class="form-submit form-wide" type="submit">
          Gönder
          <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/></svg>
        </button>
        <p class="form-note form-wide">Bilgileriniz yalnızca randevu talebinizin değerlendirilmesi amacıyla kullanılır.</p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 112px 0;
    overflow: hidden;
    background: var(--surface);
  }

  .contact-grid {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(280px, .72fr) minmax(0, 1.28fr);
    gap: clamp(64px, 8vw, 118px);
    align-items: start;
  }

  .contact-grid > *,
  .contact-form,
  .contact-form > * {
    min-width: 0;
    max-width: 100%;
  }

  .contact-copy { padding-top: 12px; }
  .contact-copy h2 { font-size: var(--type-section-title); line-height: var(--type-section-leading); }
  .contact-lead { max-width: 390px; margin: 30px 0 36px; color: var(--ink-soft); font-size: var(--type-description); line-height: var(--type-description-leading); }

  .contact-details { display: grid; gap: 18px; }
  .contact-detail { display: grid; grid-template-columns: 38px 1fr; gap: 13px; align-items: start; }
  .contact-detail > svg { width: 19px; height: 19px; margin-top: 2px; color: var(--brand); }
  .contact-detail strong { display: block; margin-bottom: 3px; color: var(--ink); font-size: 12px; font-weight: 600; }
  .contact-detail a, .contact-detail span { display: block; color: var(--brand); font-size: 13px; line-height: 1.55; }
  .contact-detail a, .contact-detail span, .form-consent span { overflow-wrap: anywhere; }

  .form-card {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--paper);
    box-shadow: 0 24px 70px rgba(48, 53, 46, .07);
  }

  .contact-form {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 18px;
  }

  .contact-form > label:not(.form-consent) {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-form > label:not(.form-consent) > span {
    color: var(--ink);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .contact-form input:not([type="checkbox"]),
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    min-width: 0;
    margin: 0;
    border: 1px solid rgba(95, 116, 95, .2);
    border-radius: 12px;
    background: var(--surface);
    color: var(--ink);
    font: 400 14px/1.5 var(--sans);
    outline: none;
    transition: border-color .2s, box-shadow .2s, background .2s;
  }

  .contact-form input:not([type="checkbox"]), .contact-form select { height: 56px; padding: 0 17px; }
  .contact-form textarea { min-height: 142px; padding: 16px 17px; resize: vertical; }
  .contact-form select { appearance: auto; }
  .contact-form input::placeholder, .contact-form textarea::placeholder { color: var(--ink-mute); opacity: .72; }

  .contact-form input:not([type="checkbox"]):focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: var(--brand);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(95, 116, 95, .11);
  }

  .form-wide { grid-column: 1 / -1; }
  .contact-form .form-consent { display: flex; flex-direction: row; align-items: flex-start; gap: 11px; margin-top: 2px; color: var(--ink-soft); font-size: 12px; font-weight: 400; letter-spacing: 0; line-height: 1.6; text-transform: none; cursor: pointer; }
  .contact-form .form-consent input { width: 17px; height: 17px; flex: 0 0 17px; margin: 2px 0 0; accent-color: var(--brand); }
  .contact-form .form-consent a { color: var(--brand); text-decoration: underline; text-underline-offset: 2px; }

  .contact-form .form-submit {
    width: 100%;
    height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border: 0;
    border-radius: 999px;
    background: var(--brand);
    color: var(--surface);
    font: 600 13px/1 var(--sans);
    letter-spacing: .04em;
    cursor: pointer;
    transition: transform .2s, background .2s, box-shadow .2s;
  }

  .contact-form .form-submit svg { width: 16px; height: 16px; }
  .contact-form .form-submit:hover { background: var(--brand-deep); transform: translateY(-2px); box-shadow: 0 12px 28px rgba(48, 53, 46, .14); }
  .contact-form .form-submit:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  .contact-form .form-note { margin: -8px 0 0; color: var(--ink-mute); font-size: 10px; line-height: 1.5; text-align: center; }

  :global(.contact-form .form-status) { grid-column: 1 / -1; margin: 4px 0 0; padding: 12px 16px; border-radius: 10px; background: var(--brand-tint); color: var(--brand-deep); font-size: 13px; text-align: center; }
  :global(.contact-form .form-status[data-state="error"]) { background: #fdecec; color: #8c2626; }

  @media (max-width: 850px) {
    .contact-section { padding: 84px 0; }
    .contact-grid { grid-template-columns: 1fr; gap: 52px; }
    .contact-lead { max-width: 600px; }
  }

  @media (max-width: 580px) {
    .contact-grid { width: calc(100% - 36px); }
    .contact-copy h2 { font-size: var(--type-section-title); }
    .form-card { padding: 24px 18px; border-radius: 18px; }
    .contact-form { grid-template-columns: 1fr; gap: 18px; }
    .contact-form > label, .form-wide { grid-column: 1; }
  }
</style>
