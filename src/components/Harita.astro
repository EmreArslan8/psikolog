---
import { business, mapsEmbedUrl, mapsDirectionsUrl } from '../data/business';
---
  <section class="map-section" aria-label="Konum">
    <iframe title={`${business.name} ofis konumu — ${business.address.district}, ${business.address.province}`} src={mapsEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    <div class="map-card reveal"><svg class="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg><div><span>Ofis Konumu</span><strong>{business.address.district} / {business.address.province}</strong><p>{business.address.full}</p><a class="map-directions" href={mapsDirectionsUrl} target="_blank" rel="noopener">Yol tarifi al <span aria-hidden="true">→</span></a></div></div>
  </section>

<style>
  .map-section {
    width: 100%;
    height: clamp(440px, 48vw, 620px);
    position: relative;
    overflow: hidden;
    background: var(--mist);
  }

  .map-section iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
    filter: grayscale(.35) sepia(.08) saturate(.75);
    opacity: .94;
  }

  .map-card {
    left: max(24px, calc((100vw - 1280px) / 2));
    top: 50%;
    bottom: auto;
    transform: translateY(-50%);
  }

  .map-card.is-visible { transform: translateY(-50%); }

  .map-directions {
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--brand);
    font-size: var(--type-meta);
    font-weight: 650;
  }

  .map-directions span { transition: transform .2s ease; }
  .map-directions:hover span { transform: translateX(4px); }

  @media (max-width: 580px) {
    .map-section { height: clamp(230px, 62vw, 270px); }
    .map-card {
      width: calc(100% - 36px);
      left: 18px;
      top: auto;
      bottom: 12px;
      padding: 14px 16px;
      grid-template-columns: 28px 1fr;
      gap: 10px;
      border-radius: 14px;
      transform: none;
    }
    .map-card > svg { width: 20px; height: 20px; }
    .map-card span { margin-bottom: 3px; font-size: 8px; }
    .map-card strong { font-size: 20px; }
    .map-card p { display: none; }
    .map-card .map-directions { display: none; }
    .map-card.is-visible { transform: none; }
  }
</style>
