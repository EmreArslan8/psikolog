<style>
  footer.site-footer > .footer-inner {
    width: min(1280px, calc(100% - 48px));
    margin-inline: auto;
    padding: 62px 0 44px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .62fr) minmax(0, .9fr) minmax(0, 1.2fr);
    gap: clamp(32px, 4vw, 58px);
    align-items: start;
    justify-items: start;
  }

  .footer-brand,
  .footer-col {
    width: 100%;
    min-width: 0;
    text-align: left;
  }

  /* Header'daki marka kilidiyle aynı: isim üstte, ünvan küçük caps altta */
  .footer-name {
    display: grid;
    gap: 5px;
    color: var(--ink);
    line-height: 1;
    white-space: nowrap;
  }

  .footer-brand-name {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.015em;
  }

  .footer-brand-role {
    color: var(--brand);
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .footer-col { align-items: flex-start; }
  .footer-contact a,
  .footer-contact p {
    width: 100%;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1120px) {
    footer.site-footer > .footer-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
      gap: 42px 58px;
    }

    .footer-brand { grid-column: 1 / -1; }
  }

  /* Mobil: Site + Hizmetler yan yana, marka ve iletişim tam genişlik —
     tek sütunda uzayıp giden footer yerine kompakt bir blok */
  @media (max-width: 620px) {
    footer.site-footer > .footer-inner {
      width: calc(100% - 36px);
      padding: 36px 0 24px;
      grid-template-columns: 1fr 1fr;
      gap: 26px 18px;
    }

    .footer-brand,
    .footer-contact { grid-column: 1 / -1; }

    .footer-brand-name { font-size: 22px; }
    .footer-brand-role { font-size: 9px; letter-spacing: .16em; }

    :global(.footer-col) { gap: 8px; }
    :global(.footer-col h3) { margin-bottom: 2px; }
    :global(.footer-col a),
    :global(.footer-col p) { line-height: 1.45; }
    :global(.footer-bottom) { padding: 16px 0 24px; gap: 6px; }
  }
</style>
