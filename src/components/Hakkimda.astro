  <section id="hakkimda" class="about-summary">
    <div class="about-narrative reveal">
      <p class="eyebrow"><span></span> Hakkımda</p>
      <h2 class="sr-only">Beni Tanıyın</h2>
      <p class="about-lead">Her insanın hikâyesi kendine özgüdür; terapi de o hikâyeye dikkatle yaklaşan güvenli bir karşılaşmadır.</p>
      <p>Merhaba, ben Selin. Terapiyi kişinin kendi iç dünyasını daha yakından tanıdığı; duygularına, ihtiyaçlarına ve ilişkilerine yeni bir yerden bakabildiği güvenli bir süreç olarak görüyorum.</p>
      <p>Çalışmalarımda kişiyi tek bir belirti üzerinden değil; yaşam öyküsü, ilişkileri, kaynakları ve içinde bulunduğu koşullarla bir bütün olarak anlamaya özen gösteriyorum.</p>
      <p>Sürecin hedeflerini ve ritmini danışanla birlikte belirlemeyi; yargısız, eşitlikçi bir ilişki kurmayı önemsiyorum.</p>
      <a class="plain-link" href="ben-kimim.html">Özgeçmişin tamamı <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
    </div>
    <figure class="about-portrait reveal reveal-delay">
      <div class="photo-placeholder" role="img" aria-label="Selin Ünal portre fotoğrafı için yer tutucu"><b>SÜ</b><small>Portre fotoğrafı</small></div>
      <figcaption><span>Psikolog</span><strong>Selin Ünal</strong></figcaption>
    </figure>
    <aside class="cred-panel reveal" aria-label="Eğitim ve sertifikalar">
      <p class="cred-title">Eğitim, Terapi ve Sertifikalar</p>

      <details class="cred-group" open>
        <summary>Akademik eğitim</summary>
        <div class="cred-body">
          <div class="cred-row"><strong>Lisans Eğitimi</strong><span>Üniversite ve bölüm bilgisi eklenecek</span></div>
          <div class="cred-row"><strong>Yüksek Lisans Eğitimi</strong><span>Üniversite ve program bilgisi eklenecek</span></div>
        </div>
      </details>

      <details class="cred-group" open>
        <summary>Terapi eğitimleri</summary>
        <div class="cred-body">
          <div class="cred-row"><strong>Bilişsel Davranışçı Terapi</strong><span>Eğitim kurumu bilgisi eklenecek</span></div>
          <div class="cred-row"><strong>EMDR Eğitimi</strong><span>Eğitim kurumu bilgisi eklenecek</span></div>
          <div class="cred-row"><strong>Şema Terapi Eğitimi</strong><span>Eğitim kurumu bilgisi eklenecek</span></div>
        </div>
      </details>

      <details class="cred-group">
        <summary>Test ve ölçek eğitimleri</summary>
        <div class="cred-body">
          <div class="cred-row"><strong>Eğitim adı eklenecek</strong><span>Eğitim kurumu ve yıl bilgisi eklenecek</span></div>
        </div>
      </details>

      <details class="cred-group">
        <summary>Süpervizyon ve üyelik</summary>
        <div class="cred-body">
          <div class="cred-row"><strong>Süpervizyon bilgisi eklenecek</strong><span>Süre ve kurum bilgisi eklenecek</span></div>
          <div class="cred-row"><strong>Mesleki üyelik eklenecek</strong><span>Dernek adı ve yıl bilgisi eklenecek</span></div>
        </div>
      </details>

    </aside>
  </section>

<style>
.about-summary{width:min(1280px,calc(100% - 48px));margin-inline:auto}
@media(max-width:580px){.about-summary{width:calc(100% - 36px)}}
çalışma biçimleri ve iletişim */
.about-summary{padding-block:120px;display:grid;grid-template-columns:1fr .92fr;gap:105px;align-items:start}
.about-narrative{max-width:520px}
.about-narrative h2{margin-bottom:34px;font-size:46px}
.about-narrative>p{margin-bottom:20px;color:var(--ink-soft);font-size:var(--text-body);line-height:1.9}
.about-narrative .plain-link{margin-top:14px}

@media(max-width:850px){.about-summary{grid-template-columns:1fr;gap:60px}
.about-narrative{max-width:none}
}
@media(max-width:580px){.about-summary{padding-block:82px}
}

/* Editoryal Hakkımda düzeni */
.about-summary{padding-block:112px;grid-template-columns:1.08fr .72fr;gap:72px 96px;align-items:center}
.about-narrative{max-width:590px}
.about-narrative h2{font-size:56px}
.about-narrative .about-lead{margin:28px 0 25px;color:var(--ink-soft);font-family:var(--serif);font-size:var(--text-lead);line-height:1.42}
.about-portrait{margin:0;position:relative}
.about-portrait::before{content:"";position:absolute;inset:18px -18px -18px 18px;z-index:-1;border-radius:220px 220px 24px 24px;background:var(--brand-tint)}
.about-portrait img{width:100%;aspect-ratio:.78;object-fit:cover;object-position:50% 43%;border-radius:220px 220px 24px 24px}
.about-portrait figcaption{position:absolute;right:-22px;bottom:26px;min-width:150px;padding:14px 20px;border:1px solid rgba(255,253,247,.72);border-radius:14px;background:rgba(255,253,247,.86);box-shadow:0 14px 38px rgba(95,116,95,.12);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
.about-portrait figcaption span{display:block;color:var(--ink-mute);font-size:8px;font-weight:600;letter-spacing:.18em;text-transform:uppercase}
.about-portrait figcaption strong{display:block;margin-top:2px;font-family:var(--serif);font-size:21px;font-weight:400}

@media(max-width:1050px) and (min-width:851px){.about-summary{gap:65px}
}
@media(max-width:850px){.about-summary{grid-template-columns:1fr;gap:58px}
.about-narrative{max-width:none}
.about-portrait{width:min(430px,88%);justify-self:center}
}
@media(max-width:580px){.about-summary{padding-block:80px}
.about-narrative h2{font-size:47px}
.about-narrative .about-lead{font-size:22px}
.about-portrait figcaption{right:-10px;bottom:18px}
}

/* Hakkımda: hero'dan ayrışan sol görsel + sağ içerik kompozisyonu */
.about-summary{position:relative;grid-template-columns:.78fr 1.12fr;grid-template-rows:auto auto;gap:34px 88px;align-items:start;padding-block:112px}
.about-summary::before{content:"";position:absolute;z-index:-2;inset:0 -100vmax;background:var(--paper);box-shadow:0 0 0 100vmax var(--paper);clip-path:inset(0 -100vmax)}
.about-summary .about-portrait{grid-column:1;grid-row:1/3;width:100%;align-self:stretch}
.about-summary .about-portrait::before{inset:-13px 13px 13px -13px;border-radius:30px;background:var(--brand-tint)}
.about-summary .about-portrait img{height:560px;min-height:0;aspect-ratio:auto;border-radius:30px;object-position:50% 38%}
.about-summary .about-portrait figcaption{right:-18px;bottom:30px}
.about-summary .about-narrative{grid-column:2;grid-row:1;max-width:650px;padding-top:8px}
.about-summary .about-narrative h2{font-size:62px}

@media(max-width:850px){.about-summary{grid-template-columns:1fr;grid-template-rows:auto;gap:52px}
.about-summary .about-narrative, .about-summary .about-portrait{grid-column:1;grid-row:auto}
.about-summary .about-portrait{width:min(520px,92%)}
.about-summary .about-portrait img{height:auto;min-height:0;aspect-ratio:.76}
}
.about-summary::before{background:var(--paper);box-shadow:0 0 0 100vmax var(--paper)}
.about-summary .about-portrait::before{background:var(--brand-soft)}
.about-summary .about-portrait figcaption{box-shadow:0 14px 38px rgba(95,116,95,.1)}
.about-summary .about-portrait figcaption span{color:var(--ink-mute)}
.about-narrative .about-lead{color:var(--ink-soft)}
.about-summary::before{background:var(--paper);box-shadow:0 0 0 100vmax var(--paper)}
.about-summary .about-portrait::before{background:var(--brand-soft)}
.about-summary .about-portrait figcaption{box-shadow:0 14px 38px rgba(95,116,95,.13)}
.about-summary .about-portrait figcaption span{color:var(--brand)}
.about-narrative .about-lead{color:var(--ink)}
.about-summary::before{inset:0;clip-path:inset(0 -100vmax)}
@media(max-width:850px){.about-summary .about-portrait figcaption{right:10px}
.about-summary .about-portrait::before{inset:-10px 10px 10px -10px}
}
.about-summary::before{background:var(--paper);box-shadow:0 0 0 100vmax var(--paper)}
@media(min-width:851px) and (max-width:1180px){
  .about-summary .about-portrait{grid-column:1;grid-row:1/3}
  .about-summary .about-narrative{grid-column:2;grid-row:1}
}

/* Portredeki mor çerçeve kaldırıldı */
.about-summary .about-portrait::before{display:none}
.about-summary .about-portrait img{box-shadow:0 22px 55px rgba(48,53,46,.1)}


/* ============================================================
   Hakkımda — D3 düzeni
   Metin solda · dikey dikdörtgen portre ortada · açılır künye sağda
   ============================================================ */
/* Bu bölümde tek serif öğe başlık; diğer her şey sans */
.about-summary .about-narrative .about-lead{font-family:var(--sans);font-size:var(--text-body);font-weight:400;line-height:var(--lh-normal);letter-spacing:0;color:var(--ink-soft)}
.about-summary .about-portrait figcaption strong{font-family:var(--sans);font-size:var(--text-body);font-weight:600;letter-spacing:0}
.cred-panel{min-width:0}
.cred-title{margin:0 0 6px;color:var(--ink-soft);font-size:var(--text-body-sm);font-weight:600;letter-spacing:var(--ls-label);text-transform:uppercase}
.cred-group{border-top:1px solid var(--line)}
.cred-group summary{display:flex;align-items:center;gap:10px;padding:14px 0;color:var(--brand-deep);font-size:var(--text-body-sm);font-weight:600;letter-spacing:0;cursor:pointer;list-style:none;transition:color .18s}
.cred-group summary::-webkit-details-marker{display:none}
.cred-group summary:hover{color:var(--brand-deep)}
.cred-group summary:focus-visible{outline:2px solid var(--brand);outline-offset:3px;border-radius:4px}
.cred-group summary::after{content:"";width:7px;height:7px;margin-left:auto;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg) translate(-2px,-2px);transition:transform .2s}
.cred-group[open] summary::after{transform:rotate(-135deg) translate(-2px,-2px)}
.cred-body{padding-bottom:10px}
.cred-row{padding:7px 0}
.cred-row strong{display:block;color:var(--ink);font-size:var(--text-body);font-weight:500;line-height:var(--lh-snug)}
.cred-row span{display:block;margin-top:4px;color:var(--ink-soft);font-size:var(--text-body-sm);line-height:var(--lh-snug)}
.cred-all{display:inline-flex;align-items:center;gap:10px;margin-top:16px;padding:5px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:var(--ink);font-size:var(--text-body-sm);font-weight:500}
.cred-all::after{content:"→";transition:transform .2s}
.cred-all:hover{border-color:var(--brand)}
.cred-all:hover::after{transform:translateX(4px)}

@media(min-width:1181px){
  .about-summary{width:min(1280px,calc(100% - 48px));grid-template-columns:minmax(0,1fr) 320px minmax(0,.9fr);gap:56px;align-items:stretch;padding-block:112px}
  .about-summary .about-narrative{grid-column:1;grid-row:1;max-width:none;display:flex;flex-direction:column}
  .about-summary .about-narrative .plain-link{margin-top:auto}
  .about-summary .about-narrative h2{margin-bottom:0;font-size:46px}
  .about-summary .about-narrative .about-lead{margin:20px 0 22px}
  .about-summary .about-narrative>p:not(.eyebrow):not(.about-lead){margin-bottom:14px;font-size:var(--text-body);line-height:var(--lh-normal)}
  .about-summary .about-portrait{grid-column:2;grid-row:1;width:100%;align-self:center}
  .about-summary .about-portrait img, .about-summary .about-portrait .photo-placeholder{width:100%;height:auto;min-height:0;aspect-ratio:.72;border-radius:20px}
  .about-summary .about-portrait .photo-placeholder::before{display:none}
  .about-summary .about-portrait figcaption{right:auto;left:50%;bottom:-20px;transform:translateX(-50%);min-width:0;padding:11px 22px;border-radius:999px;text-align:center;white-space:nowrap}
  .about-summary .cred-panel{grid-column:3;grid-row:1;display:flex;flex-direction:column}
  .about-summary .cred-panel .cred-group:last-of-type{border-bottom:1px solid var(--line)}
}
@media(min-width:1181px){
.about-summary{width:min(1440px,calc(100% - 64px));grid-template-columns:minmax(0,1.05fr) minmax(300px,.76fr) minmax(340px,1fr);grid-template-rows:auto;gap:48px;align-items:center;padding-block:105px}
.about-summary .about-narrative{grid-column:1;grid-row:1;max-width:480px;padding:0}
.about-summary .about-narrative h2{font-size:54px}
.about-summary .about-narrative .about-lead{font-size:22px}
.about-summary .about-narrative>p:not(.eyebrow):not(.about-lead){font-size:13.5px;line-height:1.82}
.about-summary .about-portrait{grid-column:2;grid-row:1;width:100%;align-self:center}
.about-summary .about-portrait img{height:520px;min-height:0;border-radius:28px}
.about-summary .about-portrait figcaption{right:14px;bottom:22px}}
@media(min-width:1181px){
.about-summary{width:min(1280px,calc(100% - 48px));grid-template-columns:minmax(0,1fr) minmax(250px,.62fr) minmax(250px,.72fr);gap:36px;padding-block:110px}
.about-summary .about-narrative{max-width:none}
.about-summary .about-narrative h2{font-size:46px}
.about-summary .about-narrative .about-lead{font-size:19px}
.about-summary .about-portrait img{height:430px;border-radius:24px}}
@media(min-width:1181px){
.about-summary{grid-template-columns:minmax(280px,.78fr) minmax(0,1.1fr) minmax(240px,.72fr)}
.about-summary .about-portrait{grid-column:1;grid-row:1}
.about-summary .about-narrative{grid-column:2;grid-row:1}}
@media(min-width:851px) and (max-width:1180px){
.about-summary .about-portrait{grid-column:1;grid-row:1/3}
.about-summary .about-narrative{grid-column:2;grid-row:1}
.about-summary .cred-panel{grid-column:2;grid-row:2}
.about-summary .about-portrait img, .about-summary .about-portrait .photo-placeholder{aspect-ratio:.74;border-radius:20px}}
@media(max-width:850px){
.about-summary .about-portrait{order:-1;width:min(300px,74%);justify-self:center}
.about-summary .about-portrait img, .about-summary .about-portrait .photo-placeholder{aspect-ratio:.74;border-radius:18px}
.about-summary .about-portrait .photo-placeholder::before{display:none}
.about-summary .about-portrait figcaption{right:auto;left:50%;bottom:-18px;transform:translateX(-50%);white-space:nowrap}}
</style>
